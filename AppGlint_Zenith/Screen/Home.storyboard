        <scene sceneID="snV-eS-ZNr">
            <objects>
                <viewController id="mgj-5v-Ixh" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="GX4-KX-LyT">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" fixedFrame="YES" lineBreakMode="tailTruncation" numberOfLines="51" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="JC9-Hh-rmb">
                                <rect key="frame" x="16" y="148" width="361" height="483"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <string key="text">At Glint, we understand that every child is unique, and that’s why we go beyond the usual to create a space where children with autism can truly thrive. Our app isn’t just about providing activities—it's about fostering meaningful interactions and empowering your child with tools that support their personal growth. From calming visuals to interactive exercises that enhance social skills, every part of **Glint** is designed to engage, comfort, and support kids as they navigate their world.

Our structured learning paths, guided by the insights from the survey, make sure that each child’s journey is personalized, giving them the right mix of activities to help them improve their communication, social interaction, and sensory regulation. Whether they're relaxing with soothing sounds or having fun with interactive games, **Glint** is all about helping kids explore, learn, and most importantly, have fun!</string>
                                <fontDescription key="fontDescription" name=".AppleSystemUIFont" family=".AppleSystemUIFont" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="bT6-1m-lkP"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                    </view>
